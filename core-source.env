# =============================================================================
# Immutable source pin for the official Streamline container image.
# =============================================================================
# This repository contains deployment artifacts only; it does NOT contain the
# Streamline core sources that `Dockerfile` compiles. Image builds must first
# materialise the core sources with `scripts/prepare-core-context.sh`, which
# checks out exactly the commit pinned here.
#
# STREAMLINE_CORE_REF MUST be a full 40-character commit SHA. Branch names and
# tags are rejected because they are mutable and cannot identify the bits that
# were actually built.
#
# To cut a release image:
#   1. Choose the core commit to release.
#   2. Set STREAMLINE_CORE_REF below to that commit's full SHA.
#   3. Open a PR; CI re-verifies the checkout resolves to the same SHA.
#
# Until a SHA is pinned, image builds fail closed rather than silently
# building whatever happens to be on a branch tip.
# =============================================================================

STREAMLINE_CORE_REPO=https://github.com/streamlinelabs/streamline.git
STREAMLINE_CORE_REF=4bac65b6be497d87dc5338b441b71dec897eed65
